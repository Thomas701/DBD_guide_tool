{
  "manifest_version": 3,
  "name": "DBD Build Analyzer — Statistiques",
  "description": "Associe Behaviour à Build Analyzer pour synchroniser vos statistiques sur Supabase, même navigateur fermé et PC éteint.",
  "version": "0.4.1",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://stats.deadbydaylight.com/*", "https://stlhqufxhcaqsllspmgr.supabase.co/*", "https://thomas701.github.io/DBD_guide_tool/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "content_scripts": [
    { "matches": ["https://stats.deadbydaylight.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://thomas701.github.io/DBD_guide_tool/*"], "js": ["site.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "externally_connectable": { "matches": ["https://thomas701.github.io/*"] },
  "action": { "default_title": "Ouvrir Build Analyzer" }
}
